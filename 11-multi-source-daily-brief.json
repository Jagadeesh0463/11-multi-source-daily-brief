      "id": "a1000008-0008-0008-0008-000000000008",
      "name": "Merge C - All Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1040, 560]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const allItems = $input.all();\n\n// ── GUARD: No content from any source ──────────────────────────\nif (!allItems || allItems.length === 0) {\n  throw new Error('NO_CONTENT: No data received from any source. Stopping workflow.');\n}\n\nconst MAX_TOTAL_CHARS = 12000;\nconst MAX_ITEM_CHARS  = 200;\nconst NOISE_REGEX = /^(hi|hello|hey|thanks|thank you|ok|okay|good morning|good afternoon|lgtm|noted|sure|👍|✅|🙏|\\+1)$/i;\n\nlet lines      = [];\nlet totalChars = 0;\n\nfor (const item of allItems) {\n  const data = item.json;\n  let source  = 'UNKNOWN';\n  let content = '';\n\n  // ── Detect source by data shape ─────────────────────────────\n  if (data.text !== undefined && data.ts !== undefined) {\n    source  = 'SLACK';\n    content = data.text || '';\n\n  } else if (data.object === 'page' || data.parent !== undefined) {\n    source = 'NOTION';\n    const props     = data.properties || {};\n    const titleProp = props.Name || props.title || props.Title;\n    content = titleProp?.title?.[0]?.plain_text\n           || titleProp?.rich_text?.[0]?.plain_text\n           || 'Untitled Notion page';\n\n  } else if (data.snippet !== undefined || data.labelIds !== undefined) {\n    source  = 'GMAIL';\n    content = (data.subject || 'No Subject') + ': ' + (data.snippet || '');\n\n  } else {\n    source  = 'SHEETS';\n    content = Object.entries(data)\n      .filter(([k]) => !['row', 'rowNumber', '__ROW_NUMBER__'].includes(k))\n      .map(([k, v]) => k + ': ' + v)\n      .join(' | ');\n  }\n\n  // ── Clean ───────────────────────────────────────────────────\n  content = content\n    .replace(/<[^>]*>/g, '')\n    .replace(/https?:\\/\\/[^\\s]+/g, '[link]')\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  if (content.length < 5) continue;\n  if (NOISE_REGEX.test(content)) continue;\n\n  if (content.length > MAX_ITEM_CHARS) {\n    content = content.substring(0, MAX_ITEM_CHARS) + '...';\n  }\n\n  const line = '[' + source + '] ' + content;\n  if (totalChars + line.length > MAX_TOTAL_CHARS) break;\n\n  lines.push(line);\n  totalChars += line.length;\n}\n\n// ── GUARD: Everything was noise ─────────────────────────────────\nif (lines.length === 0) {\n  throw new Error('NO_SIGNAL: All content filtered as noise. No meaningful updates found today.');\n}\n\nconst today = new Date().toLocaleDateString('en-IN', {\n  weekday : 'long',\n  year    : 'numeric',\n  month   : 'long',\n  day     : 'numeric',\n  timeZone: 'Asia/Kolkata'\n});\n\nreturn [{\n  json: {\n    combinedText: lines.join('\\n'),\n    today,\n    itemCount: lines.length\n  }\n}];"
      },
      "id": "a1000009-0009-0009-0009-000000000009",
      "name": "Code - Clean & Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 560]
    },
    {
      "parameters": {
        "prompt": "={{ 'Date: ' + $json.today + '\\n\\nRaw inputs to synthesize:\\n' + $json.combinedText }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessage",
              "message": "You are a professional executive assistant creating a concise morning briefing.\n\nYou will receive raw inputs tagged with their source: [SLACK], [NOTION], [GMAIL], [SHEETS].\n\nYOUR TASK:\n1. CLUSTER by TOPIC not by source — if Slack and Notion both mention the same project, merge them under one topic heading.\n2. Separate ACTION ITEMS (needs decision or response today) from informational updates.\n3. SUPPRESS noise — no trivial updates, greetings, or repeated information.\n4. OUTPUT directly as clean HTML — ready to send as email body.\n\nOUTPUT FORMAT:\n\n<h2>📅 Daily Brief — {date from input}</h2>\n\n<h3>⚡ Action Items</h3>\n<ul>\n  <li><strong>[Topic]</strong> — what needs to be done [SOURCE]</li>\n</ul>\n\n<h3>📌 Key Signals</h3>\n<ul>\n  <li><strong>[Topic]</strong> — key insight [SOURCE]</li>\n</ul>\n\n<h3>📥 FYI</h3>\n<ul>\n  <li>Low priority update, no action needed [SOURCE]</li>\n</ul>\n\nRULES:\n- Maximum 500 words total.\n- Every bullet must cite its source in brackets.\n- If no action items exist write: <p>No action items today. ✅</p>\n- If input is sparse write a shorter brief — do not pad.\n- Never invent information not present in the input.\n- Return only the HTML. No markdown, no backticks, no explanation."
            }
          ]
        },
        "options": {}
      },
